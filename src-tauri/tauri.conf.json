{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meal Planner",
  "version": "0.1.0",
  "identifier": "com.badriv.mealplanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Meal Planner", "width": 1100, "height": 800, "minWidth": 820, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
